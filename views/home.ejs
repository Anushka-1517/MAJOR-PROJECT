<% layout("layouts/boilerplate") %>
<div class="home-page">

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">
        <i class="fa-solid fa-compass"></i> Discover your next stay
      </span>

      <h1>Find your next stay, <span>anywhere.</span></h1>

      <p>
        Discover unique places to stay, explore new destinations,
        and find a space that feels like home.
      </p>

      <div class="hero-buttons">
        <a href="/listings" class="btn hero-primary">
          Explore Listings <i class="fa-solid fa-arrow-right"></i>
        </a>

        <a href="/listings/new" class="btn hero-secondary">
          List Your Property
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-card hero-card-main">
        <div class="hero-card-icon">
          <i class="fa-solid fa-house"></i>
        </div>
        <div>
          <h5>Stay somewhere memorable</h5>
          <p>Explore beautiful places made for every kind of trip.</p>
        </div>
      </div>

      <div class="floating-card floating-card-one">
        <i class="fa-solid fa-location-dot"></i>
        <div>
          <strong>New destinations</strong>
          <small>Waiting to be explored</small>
        </div>
      </div>

      <div class="floating-card floating-card-two">
        <i class="fa-solid fa-heart"></i>
        <div>
          <strong>Your next favorite</strong>
          <small>Stay could be here</small>
        </div>
      </div>
    </div>
  </section>


  <!-- Search Section -->
  <section class="home-search">
    <div class="search-heading">
      <h2>Where do you want to go?</h2>
      <p>Start exploring stays for your next adventure.</p>
    </div>

    <div class="search-box">
      <div class="search-field">
        <i class="fa-solid fa-location-dot"></i>
        <div>
          <small>Destination</small>
          <span>Search destinations</span>
        </div>
      </div>

      <div class="search-field">
        <i class="fa-regular fa-calendar"></i>
        <div>
          <small>Check in</small>
          <span>Add dates</span>
        </div>
      </div>

      <div class="search-field">
        <i class="fa-regular fa-calendar"></i>
        <div>
          <small>Check out</small>
          <span>Add dates</span>
        </div>
      </div>

      <a href="/listings" class="search-submit">
        <i class="fa-solid fa-magnifying-glass"></i>
      </a>
    </div>
  </section>


  <!-- Why WanderLust -->
  <section class="why-section">
    <div class="section-title">
      <span>WHY WANDERLUST</span>
      <h2>Everything you need for your next stay.</h2>
      <p>
        A simple way to discover places, explore destinations,
        and find accommodation that fits your journey.
      </p>
    </div>

    <div class="feature-grid">

      <div class="feature-card">
        <div class="feature-icon">
          <i class="fa-solid fa-compass"></i>
        </div>
        <h3>Explore freely</h3>
        <p>
          Browse a variety of listings and discover places
          that match your travel plans.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <i class="fa-solid fa-location-dot"></i>
        </div>
        <h3>Find the right location</h3>
        <p>
          Discover stays across different destinations
          and choose the place that works for you.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <i class="fa-solid fa-house"></i>
        </div>
        <h3>List your property</h3>
        <p>
          Have a place to share? Add your property and
          make it available for travelers to discover.
        </p>
      </div>

    </div>
  </section>


  <!-- CTA -->
  <section class="home-cta">
    <div>
      <span>YOUR NEXT ADVENTURE STARTS HERE</span>
      <h2>Ready to find your next stay?</h2>
      <p>Explore WanderLust and discover a place worth remembering.</p>
    </div>

    <a href="/listings" class="btn cta-button">
      Explore Listings <i class="fa-solid fa-arrow-right"></i>
    </a>
  </section>

</div>