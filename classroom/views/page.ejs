<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flash Demo</title>
</head>
<body>

    <% if (successMsg.length > 0) { %>
        <h3><%= successMsg[0] %></h3>
    <% } %>

    <% if (errorMsg.length > 0) { %>
        <h3><%= errorMsg[0] %></h3>
    <% } %>

    <h1>Hello, <%= name %></h1>

</body>
</html>